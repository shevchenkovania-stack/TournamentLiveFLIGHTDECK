# Line endings: этот бандл живёт в Linux (Docker-образы, systemd, Caddy), а клонировать
# его приходится с Windows, где core.autocrlf=true. Без этих правил git превратит
# supervisor.sh / relayer.sh в CRLF, и контейнеры перестанут стартовать
# ("/bin/sh: bad interpreter" или "$'\r': command not found").
*.sh    text eol=lf
Dockerfile    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
*.py    text eol=lf
Caddyfile     text eol=lf
*.service     text eol=lf
*.env*        text eol=lf
nginx.conf    text eol=lf

# Windows-only помощники — наоборот, CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Бинарное
*.mp4   binary
*.png   binary
*.jpg   binary
