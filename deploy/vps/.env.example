# Copy to .env and fill in. NEVER commit .env (gitignored).

# --- Cockpit BasicAuth (Caddy) ---
# Generate a bcrypt hash:
#   docker compose run --rm caddy caddy hash-password --plaintext 'STRONGPASSWORD'
# Paste the output here:
PANEL_HASH=

# --- MediaMTX admin ---
# Used by the supervisor to poll the control API. Keep in sync with the
# 'admin' user in mediamtx.yml (MediaMTX internal auth is not env-substituted).
MTX_ADMIN_USER=admin
MTX_ADMIN_PASSWORD=change_me_match_mediamtx_yml

# --- Auto-end (supervisor) ---
# Seconds of continuous input outage before a screen ends its broadcast by
# itself instead of looping the fallback forever. Default 3600 (1 hour), 0 = off.
# Coming back live (or RESUME in the cockpit) releases the auto-end.
AUTOEND_SEC=3600
