# systemd unit: bring the whole stack up on boot and keep the desired state.
# Install (as root), adjusting the working directory to your checkout path:
#   cp tl-streaming.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now tl-streaming
#
# Docker's own restart:unless-stopped already keeps containers alive; this unit
# additionally guarantees a converged state after host reboots / manual changes.

[Unit]
Description=TournamentLive streaming infrastructure (MediaMTX + supervisor + Caddy)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/tournamentlive/streaming-infra/deploy/vps
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
